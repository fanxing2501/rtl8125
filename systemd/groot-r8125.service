[Unit]
Description=Configure Groot r8125 queues and IRQ affinity
Wants=network-online.target groot-router-qos.service
After=network-online.target groot-router-qos.service
Before=mihomo.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/groot-r8125-start
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
